{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kivio plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "version"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "\\S" },
    "description": { "type": "string" },
    "metadata": { "type": "object", "description": "Publisher metadata only; no runtime semantics." },
    "skills": { "$ref": "#/$defs/paths" },
    "commands": { "$ref": "#/$defs/paths" },
    "agents": { "$ref": "#/$defs/paths" },
    "hooks": { "$ref": "#/$defs/paths" },
    "mcpServers": { "$ref": "#/$defs/paths" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^\\./.+",
      "allOf": [
        { "not": { "pattern": "\\\\|:" } },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } }
      ],
      "description": "Forward-slash path relative to plugin root; target must exist and remain inside root."
    },
    "paths": {
      "oneOf": [
        { "$ref": "#/$defs/path" },
        { "type": "array", "items": { "$ref": "#/$defs/path" } }
      ]
    }
  }
}
