{
  "name": "kivio",
  "private": true,
  "version": "2.9.2",
  "description": "Kivio Desktop - Screen-level AI assistant for macOS and Windows",
  "license": "GPL-3.0-or-later",
  "author": "ZM",
  "type": "module",
  "scripts": {
    "protocol:generate": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin export-chat-protocol",
    "protocol:check": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin export-chat-protocol -- --check",
    "dev": "(npm run build:swift || true) && tauri dev",
    "dev:ui": "vite --port 5713",
    "build": "npm run build:swift && npm run protocol:check && tauri build",
    "tauri": "tauri",
    "build:ui": "vite build",
    "build:swift": "node scripts/build-swift-sidecar.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "npm run protocol:check && tsc --noEmit",
    "test": "vitest run",
    "test:replace-visual": "node scripts/generate-replace-visual-fixtures.mjs --check && vitest run src/lens/replaceVisualBenchmark.test.ts",
    "fixtures:replace-visual": "node scripts/generate-replace-visual-fixtures.mjs",
    "test:watch": "vitest",
    "probe:e2e": "node scripts/probe-e2e.mjs",
    "probe:chat-performance": "node scripts/check-chat-performance-report.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lobehub/icons": "^5.10.0",
    "@milkdown/crepe": "^7.21.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "lucide-react": "^0.561.0",
    "mermaid": "^11.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-breaks": "^4.0.0",
    "streamdown": "^2.5.0",
    "virtua": "^0.49.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^2.1.9"
  },
  "main": "dist/index.html"
}
